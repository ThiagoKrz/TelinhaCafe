{
  "name": "telinha",
  "productName": "Telinha Café",
  "version": "1.2.0",
  "description": "Telinha Café: compartilhamento de tela e câmera P2P para grupos de amigos, no estilo Fate Café",
  "main": "src/main.js",
  "author": "Thiago Krauzer",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ThiagoKrz/TelinhaCafe.git"
  },
  "homepage": "https://github.com/ThiagoKrz/TelinhaCafe",
  "scripts": {
    "start": "electron .",
    "build:native": "powershell -ExecutionPolicy Bypass -File native/build.ps1",
    "build:icon": "electron build/make-icon.js",
    "dist": "npm run build:native && electron-builder --win --x64"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "br.telinha.app",
    "productName": "Telinha Café",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/peerjs/dist/peerjs.min.js"
    ],
    "extraResources": [
      {
        "from": "native/AudioCap.exe",
        "to": "AudioCap.exe"
      },
      {
        "from": "native/InputCtl.exe",
        "to": "InputCtl.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "TelinhaCafe-${version}-portatil.exe"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telinha Café",
      "artifactName": "TelinhaCafe-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "executableName": "Telinha"
  }
}
